{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "ramble-pm",
  "sandbox": {
    "network": {
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "docker compose *",
      "pnpm test:db*",
      "pnpm db:*",
      "pnpm e2e*",
      "pnpm smoke*",
      "pnpm storybook*",
      "pnpm exec playwright *"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/scripts/dev/hook-ticket-comments.ts"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/scripts/pm/board-pickup.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-guard.sh\""
          }
        ]
      }
    ]
  }
}
