# Copy to .env.local for local work. Never commit a real env file (SET-18).
# Every variable is read and validated once, in src/server/env.ts (SET-19).

# Public origin of the app. Defaults to http://localhost:3000 when unset.
APP_URL=http://localhost:3000

# Postgres. Locally both point at the docker-compose database (`docker compose up -d --wait`).
# On Neon, DATABASE_URL is the pooled host (the one with "-pooler" in its name) and
# DATABASE_URL_UNPOOLED is the direct host. App code reads only DATABASE_URL; the direct
# host is for migrations and dumps. Required everywhere except under test.
DATABASE_URL=postgres://ramble:ramble@localhost:5432/ramble
DATABASE_URL_UNPOOLED=postgres://ramble:ramble@localhost:5432/ramble

# Local reads. Guest pages read through Neon's HTTP driver, which cannot reach the docker-compose Postgres.
# Run `pnpm db:http` in a second terminal, copy the address it prints here, and restart `pnpm dev` (or
# `pnpm start`). Local addresses only (localhost, 127.0.0.1, ::1); env validation refuses any other host,
# and refuses the variable in a Vercel production or preview deployment. Leave it unset on Neon.
# NEON_HTTP_ENDPOINT=http://127.0.0.1:4444/sql

# Seed. `pnpm db:seed` refuses to run unless this says what the database is: local, staging, load-test, or production-demo.
# It also refuses under NODE_ENV=production, and under VERCEL_ENV=production or for a database named like production
# unless this is production-demo. `local` additionally requires a database on this machine.
# production-demo is the one explicit way to seed the production database for the Prototype demo; it takes the curated
# set only (no --scale). Never set it in a file the app reads; docs/runbooks/seed.md has the steps.
# SEED_TARGET=local
# Every target except local also needs SEED_HOST set to the host in DATABASE_URL, exactly, so a seed pointed at
# the wrong database stops before it writes.
# SEED_HOST=ep-example-123.us-east-2.aws.neon.tech

# Email. With none of these set, every message goes to the in-app dev mailbox and nothing leaves the process.
# EMAIL_MODE: sink (default) keeps every message in the dev mailbox; allowlist sends only to EMAIL_ALLOWLIST
# through EMAIL_PROVIDER and keeps the rest in the mailbox; live sends everything and is accepted only in a
# production deployment with a real provider.
# EMAIL_MODE=sink
# EMAIL_PROVIDER=fake            # fake | resend | postmark
# EMAIL_ALLOWLIST=               # comma-separated addresses or @domain entries
# A real provider needs all four of the next lines, plus its own key. EMAIL_WEBHOOK_SECRET is Resend's
# `whsec_` signing secret, or the basic-auth password set on Postmark's webhook URL.
# EMAIL_FROM=Ramble <hello@your-domain.example>
# EMAIL_REPLY_TO=support@your-domain.example
# EMAIL_WEBHOOK_SECRET=
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=

# Opens /ops/mailbox, which shows every captured message including its links. At least 32 characters,
# for example `openssl rand -hex 32`. Unset, the page refuses everyone; it is also off in live mode.
# DEV_MAILBOX_SECRET=

# Photo and document storage. With none of these set, objects live in memory (the fake adapter), which
# is enough for tests and local work; they vanish on restart and their addresses are not displayable.
# The fake is allowed in every environment, a production deployment included, for the demo; the refusal
# returns in U-021b once the photo pool is stored.
# STORAGE_PROVIDER=fake          # fake | vercel-blob
# vercel-blob needs two stores, because a Blob store is either public or private: a public one for
# photos and a private one for host documents. Create them with `vercel blob create-store <name> --access public`
# (and `--access private`), then paste each store's read-write token.
# BLOB_PUBLIC_READ_WRITE_TOKEN=
# BLOB_PRIVATE_READ_WRITE_TOKEN=

# Monitoring. Every variable below is optional; with none set the logger still redacts and
# stamps request IDs, and Sentry and Axiom are no-ops.
# Sentry DSN for server-side errors and alerts raised through alerts.raise.
SENTRY_DSN=
# Sentry DSN for the browser loader script. Guest pages only, never checkout. A browser DSN is
# public by design. Can equal SENTRY_DSN, or point at a separate browser project.
SENTRY_BROWSER_DSN=
# Axiom ingest token and dataset for warning and error logs. Set both or neither.
AXIOM_TOKEN=
AXIOM_DATASET=

# Signs the guest-form token (honeypot and minimum fill time). At least 32 characters. Optional in
# development and test, where a fixed secret stands in; a deployed environment sets its own, or the
# guest forms refuse to render. Generate one with `openssl rand -base64 48`.
# FORM_GUARD_SECRET=
