# Copy to .env.local for local work. Never commit a real env file (SET-18).
# Every variable is read and validated once, in src/server/env.ts (SET-19).

# Public origin of the app. Defaults to http://localhost:3000 when unset.
APP_URL=http://localhost:3000

# Postgres. Locally both point at the docker-compose database (`docker compose up -d --wait`).
# On Neon, DATABASE_URL is the pooled host (the one with "-pooler" in its name) and
# DATABASE_URL_UNPOOLED is the direct host. App code reads only DATABASE_URL; the direct
# host is for migrations and dumps. Required everywhere except under test.
DATABASE_URL=postgres://ramble:ramble@localhost:5432/ramble
DATABASE_URL_UNPOOLED=postgres://ramble:ramble@localhost:5432/ramble

# Monitoring. Every variable below is optional; with none set the logger still redacts and
# stamps request IDs, and Sentry and Axiom are no-ops.
# Sentry DSN for server-side errors and alerts raised through alerts.raise.
SENTRY_DSN=
# Sentry DSN for the browser loader script. Guest pages only, never checkout. A browser DSN is
# public by design. Can equal SENTRY_DSN, or point at a separate browser project.
SENTRY_BROWSER_DSN=
# Axiom ingest token and dataset for warning and error logs. Set both or neither.
AXIOM_TOKEN=
AXIOM_DATASET=

# Signs the guest-form token (honeypot and minimum fill time). At least 32 characters. Optional in
# development and test, where a fixed secret stands in; a deployed environment sets its own, or the
# guest forms refuse to render. Generate one with `openssl rand -base64 48`.
# FORM_GUARD_SECRET=
