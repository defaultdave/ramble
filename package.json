{
  "name": "ramble",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "@vercel/cli-config>zod": ">=4.6.6",
      "@esbuild-kit/core-utils>esbuild": ">=0.25.0"
    }
  },
  "scripts": {
    "postinstall": "next typegen || echo 'next typegen failed; lint and typecheck run it again'",
    "dev": "next dev",
    "build": "next build",
    "build:profile": "next build --profile",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "next typegen && eslint . --max-warnings 0 --report-unused-disable-directives && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-size.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit --project components",
    "test:db": "vitest run --project db",
    "knip": "knip",
    "tokens:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/tokens/build.ts",
    "e2e": "playwright test",
    "smoke": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:http": "bun scripts/dev/neon-http.ts",
    "db:seed": "bun --preload ./scripts/seed-preload.ts scripts/seed.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o node_modules/.cache/storybook-static",
    "storybook:test": "vitest run --config .storybook/vitest.config.mts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/nextjs": "^11.11.0",
    "@tiptap/static-renderer": "^3.33.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.11.0",
    "@vercel/speed-insights": "^2.1.0",
    "botid": "^1.5.12",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@next/env": "^16.4.5",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/nextjs-vite": "^10.6.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "storybook": "^10.6.6",
    "style-dictionary": "^5.8.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
