          "value": "\"experiences\".\"duration_minutes\" > 0"
        },
        "experiences_age_rule_limits": {
          "name": "experiences_age_rule_limits",
          "value": "(\n        \"experiences\".\"age_rule\" IN ('all_ages', 'twenty_one_plus')\n          AND \"experiences\".\"min_age\" IS NULL AND \"experiences\".\"max_age\" IS NULL\n      ) OR (\n        \"experiences\".\"age_rule\" = 'minimum_age'\n          AND \"experiences\".\"min_age\" IS NOT NULL AND \"experiences\".\"min_age\" >= 0\n          AND \"experiences\".\"max_age\" IS NULL\n      ) OR (\n        \"experiences\".\"age_rule\" = 'age_range'\n          AND \"experiences\".\"min_age\" IS NOT NULL AND \"experiences\".\"min_age\" >= 0\n          AND \"experiences\".\"max_age\" IS NOT NULL AND \"experiences\".\"max_age\" >= \"experiences\".\"min_age\"\n      )"
        },
        "experiences_outdoor_has_weather_policy": {
          "name": "experiences_outdoor_has_weather_policy",
          "value": "NOT \"experiences\".\"outdoor\" OR \"experiences\".\"weather_policy\" IS NOT NULL"
        },
        "experiences_weather_decision_hours": {
          "name": "experiences_weather_decision_hours",
          "value": "coalesce(\"experiences\".\"weather_policy\" = 'decided_before_start', false)\n        = (\"experiences\".\"weather_decision_hours\" IS NOT NULL)\n        AND coalesce(\"experiences\".\"weather_decision_hours\" > 0, true)"
        },
        "experiences_guide_only_has_link": {
          "name": "experiences_guide_only_has_link",
          "value": "\"experiences\".\"status\" <> 'guide_only' OR \"experiences\".\"link_out_url\" IS NOT NULL"
        },
        "experiences_link_out_url_http": {
          "name": "experiences_link_out_url_http",
          "value": "\"experiences\".\"link_out_url\" IS NULL OR \"experiences\".\"link_out_url\" ~* '^https?://([A-Za-z0-9-]+\\.)*[A-Za-z][A-Za-z0-9-]*(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[0-9]{1,4}))?([/?#][^[:space:]]*)?$'"
        },
        "experiences_affiliate_url_http": {
          "name": "experiences_affiliate_url_http",
          "value": "\"experiences\".\"affiliate_url\" IS NULL OR \"experiences\".\"affiliate_url\" ~* '^https?://([A-Za-z0-9-]+\\.)*[A-Za-z][A-Za-z0-9-]*(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[0-9]{1,4}))?([/?#][^[:space:]]*)?$'"
        }
